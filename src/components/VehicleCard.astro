---
import { brl, kmFmt } from '../lib/site';
import { fotosOrdenadas, tituloVeiculo } from '../lib/supabase';
const { v } = Astro.props;
const capa = fotosOrdenadas(v)[0];
const meta = [v.ano_modelo, kmFmt(v.km), v.cambio, v.combustivel].filter(Boolean).join(', ');
---
<a class="vcard" href={`/veiculo/${v.slug}`}>
  {capa
    ? <img class="foto" src={capa.url} alt={capa.alt ?? tituloVeiculo(v)} loading="lazy" width="1200" height="1200" />
    : <div class="foto-ph">Fotos em breve</div>}
  <div class="info">
    {v.status === 'vendido' && <span class="selo">Vendido</span>}
    <h3>{tituloVeiculo(v)}</h3>
    <div class="meta">{meta}{v.bairro ? ` · ${v.bairro}` : ''}</div>
    <div class="preco">{brl(v.preco)}</div>
  </div>
</a>

<style>
  .vcard {
    display: flex;
    flex-direction: column; /* card com altura igual ao da linha */
    width: 100%;
    min-width: 0;
    height: 100%;
  }
  .vcard .foto,
  .vcard .foto-ph {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    margin: 0;
  }
  .vcard .foto-ph {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vcard .info {
    flex: 1; /* empurra o conteúdo e iguala a altura dos cards */
  }

  /* ===== CELULAR: foto mais baixa, sem faixa em volta, card compacto ===== */
  @media (max-width: 600px) {
    .vcard .foto,
    .vcard .foto-ph {
      aspect-ratio: 4 / 3 !important;
      object-fit: cover !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
    }
    .vcard .info {
      padding: 12px 14px 14px !important;
    }
    .vcard .info h3 {
      font-size: 1.05rem !important;
      line-height: 1.25 !important;
      margin: 0 0 4px !important;
    }
    .vcard .meta {
      font-size: 0.85rem !important;
      margin: 0 0 6px !important;
    }
    .vcard .preco {
      font-size: 1.25rem !important;
    }
  }
</style>
