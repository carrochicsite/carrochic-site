<style>
  /* PC e notebook: 4 carros por linha, 2 linhas = 8 por página */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .grid > :global(*) {
    min-width: 0;
    height: 100%;
  }

  /* Tablet / tela pequena: 2 por linha */
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* Celular: 1 carro por linha, 8 carros em coluna */
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
