---
const { title = 'Painel', logado = true } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · CARROCHIC admin</title>
    <style is:global>
      :root { --navy:#0B1F4B; --line:#d9deea; --bg:#f4f6fb; --ok:#127a3e; --bad:#b3261e; }
      * { box-sizing:border-box; }
      body { margin:0; font:16px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:#1b2233; }
      a { color:var(--navy); }
      .top { background:var(--navy); color:#fff; display:flex; align-items:center; gap:1rem; padding:.7rem 1rem; }
      .top a { color:#fff; text-decoration:none; font-weight:700; }
      .top .sp { flex:1; }
      .top form { margin:0; }
      .box { max-width:1000px; margin:1.2rem auto; padding:0 1rem; }
      .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:1rem; margin-bottom:1rem; }
      h1 { font-size:1.4rem; margin:.2rem 0 1rem; color:var(--navy); }
      h2 { font-size:1.1rem; margin:0 0 .8rem; color:var(--navy); }
      label { display:block; font-size:.85rem; font-weight:600; margin-bottom:.2rem; }
      input, select, textarea { width:100%; padding:.55rem .6rem; border:1px solid #b9c1d4; border-radius:8px; font:inherit; background:#fff; }
      textarea { min-height:120px; resize:vertical; }
      .grid { display:grid; gap:.8rem; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); }
      .btn { display:inline-block; padding:.55rem .9rem; border:0; border-radius:8px; background:var(--navy); color:#fff; font:inherit; font-weight:600; cursor:pointer; text-decoration:none; }
      .btn.sec { background:#fff; color:var(--navy); border:1px solid var(--navy); }
      .btn.red { background:var(--bad); }
      .btn.sm { padding:.3rem .6rem; font-size:.85rem; }
      .msg { padding:.6rem .8rem; border-radius:8px; margin-bottom:1rem; }
      .msg.ok { background:#e3f5ea; color:var(--ok); } .msg.erro { background:#fdeceb; color:var(--bad); }
      table { width:100%; border-collapse:collapse; } th,td { text-align:left; padding:.5rem; border-bottom:1px solid var(--line); vertical-align:middle; }
      th { font-size:.8rem; color:#5b6580; }
      .tag { font-size:.75rem; padding:.15rem .5rem; border-radius:99px; background:#e6e9f2; }
      .tag.ativo { background:#e3f5ea; color:var(--ok); }
      .box img { max-width:100%; height:auto; }
      .box .card img { width:160px; height:160px; object-fit:cover; border-radius:8px; display:block; }
    </style>
  </head>
  <body>
    {logado && (
      <div class="top">
        <a href="/admin">CARROCHIC admin</a>
        <a href="/admin/vendedores">vendedores</a>
        <span class="sp"></span>
        <a href="/" target="_blank" rel="noopener">ver site</a>
        <form method="post" action="/admin/sair">
          <button class="btn sec sm" type="submit">Sair</button>
        </form>
      </div>
    )}
    <div class="box">
      <slot />
    </div>
  </body>
</html>
