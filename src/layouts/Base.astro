---
import '../styles/global.css';
import { SITE, NOINDEX, TIPOS } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object[];
  waMsg?: string; // não é mais usado: a mensagem é montada na rota /wa/
  waSlug?: string; // slug do veículo, para o botão abrir a conversa citando o carro
}
const { title, description, path = Astro.url.pathname, image, noindex = false, jsonLd = [], waSlug } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
const robots = NOINDEX || noindex ? 'noindex, nofollow' : 'index, follow';
// Todos os botões passam pela rota /wa/, que escolhe o número do vendedor (cookie) ou o seu.
const wa = `/wa/${waSlug ?? 'geral'}`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0B1F4B" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,100..125,400..800;1,100..125,800&family=Barlow:wght@400;500;600&display=swap" />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">CARRO<b>CHIC</b>®</a>
        <nav id="menu-principal" aria-label="Principal" data-menu>
          {Object.values(TIPOS).map((t) => <a href={`/${t.slug}`}>{t.rotulo}</a>)}
        </nav>
        <div class="hd-acoes">
          <a class="btn btn-primary" href={wa} rel="nofollow noopener">WhatsApp</a>
          <button type="button" class="burger" data-burger aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <a class="logo" href="/">CARRO<b>CHIC</b>®</a>
        <div class="cols">
          <div>
            <p>Atendimento personalizado em {SITE.area}.</p>
            <p><a href={wa} rel="nofollow noopener">Falar no WhatsApp</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
          <ul>
            {Object.values(TIPOS).map((t) => <li><a href={`/${t.slug}`}>{t.rotulo} em {SITE.cidade}</a></li>)}
          </ul>
        </div>
        <p class="fine">© {new Date().getFullYear()} {SITE.nome} — {SITE.cidade}, {SITE.uf}</p>
      </div>
    </footer>
    <a class="btn btn-wa wa-flutuante" href={wa} rel="nofollow noopener">Falar no WhatsApp</a>
  </body>
</html>

<script>
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-menu]');
  if (burger && menu) {
    const alternar = (abrir) => {
      menu.classList.toggle('aberto', abrir);
      burger.classList.toggle('aberto', abrir);
      burger.setAttribute('aria-expanded', String(abrir));
      burger.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
    };
    burger.addEventListener('click', () => alternar(!menu.classList.contains('aberto')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => alternar(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') alternar(false); });
    window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => { if (e.matches) alternar(false); });
  }
</script>
