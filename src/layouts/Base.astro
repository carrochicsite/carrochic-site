---
import '../styles/global.css';
import { SITE, NOINDEX, TIPOS, waLink } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object[];
  waMsg?: string;
}
const { title, description, path = Astro.url.pathname, image, noindex = false, jsonLd = [], waMsg = 'Olá! Vim pelo site da CARROCHIC e quero saber mais sobre os veículos.' } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
const robots = NOINDEX || noindex ? 'noindex, nofollow' : 'index, follow';
const wa = waLink(waMsg);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0B1F4B" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,100..125,400..800;1,100..125,800&family=Barlow:wght@400;500;600&display=swap" />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">CARRO<b>CHIC</b>®</a>
        <nav aria-label="Principal">
          {Object.values(TIPOS).map((t) => <a href={`/${t.slug}`}>{t.rotulo}</a>)}
        </nav>
        <a class="btn btn-primary" href={wa} rel="noopener">WhatsApp</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <a class="logo" href="/">CARRO<b>CHIC</b>®</a>
        <div class="cols">
          <div>
            <p>Atendimento personalizado em {SITE.area}.</p>
            <p><a href={wa} rel="noopener">WhatsApp {SITE.telefone}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
          <ul>
            {Object.values(TIPOS).map((t) => <li><a href={`/${t.slug}`}>{t.rotulo} em {SITE.cidade}</a></li>)}
          </ul>
        </div>
        <p class="fine">© {new Date().getFullYear()} {SITE.nome} — {SITE.cidade}, {SITE.uf}</p>
      </div>
    </footer>
    <a class="btn btn-wa wa-flutuante" href={wa} rel="noopener">Falar no WhatsApp</a>
  </body>
</html>
